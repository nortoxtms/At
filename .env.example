# ONLY HORSES — environment template
# Based on spec §6, adjusted for ADR-0001 (Google Cloud) and ADR-0002 (Expo).
# Copy to .env and fill in. Never commit .env (§24.24).

# ── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
LAUNCH_REGION=TR
DEFAULT_LOCALE=tr
DEFAULT_CURRENCY=EUR

# ── Database — Cloud SQL for PostgreSQL (ADR-0001) ─────────────────────
# DATABASE_URL uses the pooled app role (no BYPASSRLS — see ADR-0004).
# DIRECT_URL uses the owner role and is only for migrations.
DATABASE_URL=postgresql://only_horses_app:postgres@localhost:5432/only_horses
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/only_horses
# Cloud Run attaches Cloud SQL over a unix socket; leave empty locally.
CLOUD_SQL_INSTANCE_CONNECTION_NAME=

# ── Google Cloud ───────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=europe-west1
# Omit on Cloud Run — workload identity supplies credentials automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Firebase Auth (replaces Supabase Auth + Twilio Verify) ─────────────
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── API session tokens ─────────────────────────────────────────────────
# The API exchanges a Firebase ID token for its own short-lived session.
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Search ─────────────────────────────────────────────────────────────
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_SEARCH_ONLY_KEY=

# ── Storage / media ────────────────────────────────────────────────────
GCS_BUCKET=only-horses-media
GCS_UPLOAD_URL_TTL_SECONDS=900
# Documents are served on 5-minute signed URLs (§10.3).
GCS_DOCUMENT_URL_TTL_SECONDS=300
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# ── Payments ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_BOOST_7D=
STRIPE_PRICE_BOOST_30D=
STRIPE_PRICE_JOB_POST=
# Stripe Identity is retained: Firebase has no equivalent, and §14.1 makes
# identity verification the gate for publishing.
STRIPE_IDENTITY_WEBHOOK_SECRET=

# ── Comms ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Push uses the Firebase service account above; no separate FCM key needed.

# ── Chat ───────────────────────────────────────────────────────────────
STREAM_API_KEY=
STREAM_API_SECRET=

# ── Observability ──────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ── Queue — Memorystore for Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Moderation ─────────────────────────────────────────────────────────
PERSPECTIVE_API_KEY=
IMAGE_HASH_THRESHOLD=10

# ── Web (Next.js public vars) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# ── Mobile (Expo public vars) ──────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_POSTHOG_KEY=
