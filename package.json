{
  "name": "only-horses",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/migrate.mjs --reset",
    "seed:ref": "node scripts/migrate.mjs --seed",
    "seed:dev": "node apps/api/scripts/seed-dev.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,sql}\"",
    "db:status": "node scripts/migrate.mjs --status",
    "test:db": "bash scripts/test-db.sh"
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
