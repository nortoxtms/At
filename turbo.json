{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "APP_URL", "API_URL", "LAUNCH_REGION", "DEFAULT_LOCALE", "DEFAULT_CURRENCY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false
    }
  }
}
